add table inet anotherrae_worker
flush table inet anotherrae_worker

table inet anotherrae_worker {
    set restricted_v4 {
        type ipv4_addr
        flags interval
        elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16,
                     172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.88.99.0/24, 192.168.0.0/16,
                     198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/3 }
    }
    chain before_dnat {
        type filter hook prerouting priority -151; policy accept;
        iifname "br-rae-worker" meta nfproto ipv6 drop
        iifname "br-rae-worker" fib daddr type { local, broadcast, multicast } drop
        iifname "br-rae-worker" ip daddr @restricted_v4 drop
    }
    chain input {
        type filter hook input priority -5; policy accept;
        iifname "br-rae-worker" drop
    }
    chain forward {
        type filter hook forward priority -5; policy accept;
        iifname "br-rae-worker" ip daddr @restricted_v4 drop
        oifname "br-rae-worker" ct state != { established, related } drop
    }
}
