abi <abi/4.0>,
include <tunables/global>

profile anotherrae-project-worker flags=(attach_disconnected,mediate_deleted) {
  / r,
  /** mrkix,
  /work/ rw,
  /work/** rwklm,
  /tmp/{newroot,oldroot}/ rw,
  /tmp/codex-daemon-20002/ rw,
  /tmp/newroot/** rwklm,
  /newroot/ rw,
  /newroot/** rwklm,
  /oldroot/ rw,
  /var/lib/rae-worker/ rw,
  /var/lib/rae-worker/** rwkl,
  /run/anotherrae-worker-api/device.sock rw,
  /run/rae-device-api/device.sock rw,
  /dev/{null,zero,random,urandom,tty,ptmx} rw,
  /dev/pts/** rw,
  @{PROC}/@{pid}/{uid_map,gid_map,setgroups} rw,
  @{PROC}/self/{uid_map,gid_map,setgroups} rw,
  ptrace (read, readby) peer=anotherrae-project-worker,
  network inet,
  network unix,
  network netlink raw,
  userns,
  capability,
  mount,
  umount,
  pivot_root,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (send, receive) peer=anotherrae-project-worker,
  deny network alg,
  deny network vsock,
  deny @{PROC}/sys/** w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/** wklx,
  deny /sys/firmware/** r,
  deny /sys/kernel/security/** r,
}
