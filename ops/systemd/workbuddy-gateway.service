[Unit]
Description=WorkBuddy2API Hub
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=workbuddy-gw
Group=workbuddy-gw
WorkingDirectory=/opt/workbuddy-gateway/current
Environment=HOME=/var/lib/workbuddy-gateway
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=WB_MAX_CONCURRENT_CHAT=2
Environment=WB_MAX_PAYLOAD_BYTES=2097152
Environment=WB_MEDIA_DIR=/var/lib/workbuddy-gateway/media
Environment=TZ=UTC
ExecStart=/usr/bin/python3 /opt/workbuddy-gateway/current/wb_proxy.py --host 127.0.0.1 --port 8788 --accounts-dir /var/lib/workbuddy-gateway/accounts --usage-dir /var/lib/workbuddy-gateway/usage
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
UMask=0077
StateDirectory=workbuddy-gateway
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/lib/workbuddy-gateway
MemoryHigh=200M
MemoryMax=400M
CPUQuota=75%
TasksMax=128

[Install]
WantedBy=multi-user.target
