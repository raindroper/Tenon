{
  "name": "tenon",
  "version": "0.1.35",
  "productName": "榫 Tenon",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "concurrently -k \"node scripts/with-runtime.mjs node_modules/tsx/dist/cli.mjs watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/with-runtime.mjs node_modules/tsx/dist/cli.mjs server/index.ts",
    "check": "tsc --noEmit",
    "compare:method": "node scripts/with-runtime.mjs --import tsx scripts/compare-method.ts",
    "test": "node scripts/with-runtime.mjs scripts/test.mjs",
    "test:stability": "node scripts/with-runtime.mjs scripts/test.mjs tests/stability/soak.test.ts",
    "test:wechat": "node scripts/with-runtime.mjs scripts/test-wechat.mjs",
    "prepare:memory-model": "node scripts/with-runtime.mjs --import tsx scripts/prepare-memory-model.mjs",
    "prepare:ews": "node scripts/with-runtime.mjs scripts/build-ews.mjs",
    "desktop:build": "node scripts/with-runtime.mjs scripts/build-desktop.mjs",
    "desktop:start": "node scripts/with-runtime.mjs node_modules/electron/cli.js .local/desktop-build",
    "desktop:package": "node scripts/with-runtime.mjs scripts/package-desktop.mjs",
    "desktop:sign-update": "node scripts/with-runtime.mjs scripts/sign-desktop-update.mjs"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.77",
    "@ai-sdk/openai": "4.0.117",
    "@azure/msal-node": "7.2.1",
    "@googleapis/gmail": "22.0.2",
    "@mastra/core": "1.81.0",
    "@mastra/fastembed": "1.3.6",
    "@mastra/libsql": "1.28.0",
    "@mastra/mcp": "2.8.0",
    "@mastra/memory": "1.40.0",
    "@microsoft/microsoft-graph-client": "3.0.7",
    "@microsoft/mxc-sdk": "1.0.1",
    "@playwright/mcp": "0.0.85",
    "ai": "^7.0.159",
    "adm-zip": "0.6.1",
    "chokidar": "^5.0.0",
    "electron-updater": "6.8.12",
    "fast-glob": "^3.3.3",
    "google-auth-library": "11.3.3",
    "iconv-lite": "0.7.3",
    "lucide-react": "^1.66.0",
    "oauth4webapi": "3.8.8",
    "p-queue": "^10.0.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sax": "1.6.1",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sax": "1.2.7",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "jose": "6.2.15",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "undici": "7.30.1",
    "vite": "^8.3.5"
  }
}
